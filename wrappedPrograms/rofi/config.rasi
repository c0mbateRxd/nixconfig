configuration {
    modi:                "drun,run";
    show-icons:          true;
    drun-display-format: "{name}";
    display-drun:        "";
}

/* Eldritch Ash — Rofi launcher theme
 * Blends Evangelion icy tones with Steampunk Brass.
 */

* {
    /* Palette */
    bg:          #08090d;
    surface:     #10131a;
    elevated:    #1b202c;
    border-col:  #2a3245;
    dim:         #566580;
    text-col:    #a1acc2;
    bright:      #ccd4e6;
    brass:       #c97b28;
    crimson:     #b83333;
    icy-cyan:    #5299ad;

    /* Reset */
    background-color:   transparent;
    text-color:         @text-col;
    border:             0;
    margin:             0;
    padding:            0;
    spacing:            0;
}

window {
    background-color: @surface;
    border:           1px;
    border-color:     @border-col;
    border-radius:    10px;
    width:            480px;
    padding:          10px;
}

mainbox {
    background-color: transparent;
    spacing:          6px;
}

/* ── Input row ────────────────────────────────────────────── */
inputbar {
    background-color: @elevated;
    border-radius:    7px;
    padding:          8px 12px;
    spacing:          8px;
    children:         [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color:       @icy-cyan;
    font:             "Cinzel 12";
    vertical-align:   0.5;
}

entry {
    background-color: transparent;
    text-color:       @bright;
    font:             "JetBrainsMono Nerd Font 12";
    placeholder:      "search...";
    placeholder-color: @dim;
    vertical-align:   0.5;
}

/* ── Results list ─────────────────────────────────────────── */
listview {
    background-color: transparent;
    spacing:          3px;
    lines:            8;
    columns:          1;
}

element {
    background-color: transparent;
    border-radius:    5px;
    padding:          6px 10px;
    spacing:          8px;
    children:         [ element-icon, element-text ];
}

element selected {
    background-color: @elevated;
    border: 1px;
    border-color: @border-col;
}

element-icon {
    background-color: transparent;
    size:             18px;
    vertical-align:   0.5;
}

element-text {
    background-color: transparent;
    text-color:       @text-col;
    font:             "JetBrainsMono Nerd Font 12";
    vertical-align:   0.5;
}

element selected > element-text {
    text-color: @brass;
}

/* ── Scrollbar ────────────────────────────────────────────── */
scrollbar {
    background-color: @elevated;
    handle-color:     @icy-cyan;
    handle-width:     4px;
    border-radius:    2px;
    width:            6px;
}
